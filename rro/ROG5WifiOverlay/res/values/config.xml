<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The ROG5 Wi-Fi chip supports two concurrent STA interfaces (wlan0 + wlan1).
         Enable multi-STA so the Network Acceleration Hub (TrebleApp Dual Wi-Fi)
         can keep a second internet connection on the other band. -->
    <bool name="config_wifiMultiStaMultiInternetConcurrencyEnabled">true</bool>
    <bool name="config_wifiMultiStaNetworkSwitchingMakeBeforeBreakEnabled">true</bool>
    <bool name="config_wifiMultiStaLocalOnlyConcurrencyEnabled">true</bool>
    <bool name="config_wifiMultiStaRestrictedConcurrencyEnabled">true</bool>
</resources>
